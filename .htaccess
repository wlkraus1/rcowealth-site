# rcowealth.com: redirects and a deny list for internal files.

# Internal files must never be served even if a deploy carries them to the
# webroot (generator source, notes, QA output). The site fetches no .json,
# .md, .py or .yaml file at runtime. Twilio's phone/*.xml stays public.
<FilesMatch "\.(md|py|pyc|yaml|yml|json)$">
  Require all denied
</FilesMatch>

# mobile.html retired: the rebuild is responsive, one URL per page.
Redirect 301 /mobile.html https://rcowealth.com/

# Old percent-encoded or trailing variants occasionally seen in logs
Redirect 301 /index.htm https://rcowealth.com/

# One origin. The quote flow and attribution live in sessionStorage, which does
# not cross www. and the apex, so send www. to the apex before anything runs.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.rcowealth\.com$ [NC]
RewriteRule ^(.*)$ https://rcowealth.com/$1 [R=301,L]
